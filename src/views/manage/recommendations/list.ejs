<%- include('../../partials/header', { title, isAuthenticated: true, csrfToken }) %>

<h1>Recommendations</h1>

<section aria-labelledby="new-recommendation-heading">
  <h2 id="new-recommendation-heading">Add a recommendation</h2>
  <% if (fieldErrors && Object.keys(fieldErrors).length > 0) { %>
    <div class="banner banner-error" role="alert">Please fix the errors below.</div>
  <% } %>
  <form method="post" action="/manage/recommendations" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-field">
      <label for="title">Title <span aria-hidden="true">*</span></label>
      <input type="text" id="title" name="title" value="<%= values.title || '' %>" required maxlength="300" aria-describedby="title-error">
      <% if (fieldErrors.title) { %><p class="field-error" id="title-error"><%= fieldErrors.title %></p><% } %>
    </div>
    <div class="form-field">
      <label for="issuer">Issuer</label>
      <input type="text" id="issuer" name="issuer" value="<%= values.issuer || '' %>" maxlength="200">
      <% if (fieldErrors.issuer) { %><p class="field-error" id="issuer-error"><%= fieldErrors.issuer %></p><% } %>
    </div>
    <button type="submit" class="button-primary">Add recommendation</button>
  </form>
</section>

<% if (recommendations.length === 0) { %>
  <p>No recommendations yet.</p>
<% } else { %>
  <ul class="manage-list">
    <% recommendations.forEach(function (r) { %>
      <li class="manage-item">
        <div class="manage-item-main">
          <h3><%= r.title %></h3>
          <p class="meta"><% if (r.issuer) { %><%= r.issuer %><% } %></p>
        </div>
        <div class="manage-item-actions">
          <form method="post" action="/manage/recommendations/<%= r.id %>/delete" class="inline-form" data-confirm="Delete this recommendation?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="link-button link-danger">Delete</button>
          </form>
        </div>
        <details class="edit-disclosure">
          <summary>Edit</summary>
          <form method="post" action="/manage/recommendations/<%= r.id %>" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="form-field">
              <label for="rec-title-<%= r.id %>">Title <span aria-hidden="true">*</span></label>
              <input type="text" id="rec-title-<%= r.id %>" name="title" value="<%= r.title %>" required maxlength="300">
            </div>
            <div class="form-field">
              <label for="rec-issuer-<%= r.id %>">Issuer</label>
              <input type="text" id="rec-issuer-<%= r.id %>" name="issuer" value="<%= r.issuer || '' %>" maxlength="200">
            </div>
            <button type="submit" class="button-secondary">Save changes</button>
          </form>
        </details>
      </li>
    <% }); %>
  </ul>
<% } %>

<%- include('../../partials/footer') %>
