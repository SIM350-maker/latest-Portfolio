<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · Portfolio</title>
  <style>
    :root { color-scheme: light; }
    * { box-sizing: border-box; }
    body {
      font-family: Georgia, 'Times New Roman', serif;
      color: #111;
      max-width: 46rem;
      margin: 0 auto;
      padding: 2rem 1.25rem;
      line-height: 1.5;
      background: #fff;
    }
    header h1 { margin: 0 0 0.25rem; font-size: 1.75rem; }
    header .role { margin: 0; font-size: 1.05rem; color: #333; }
    header .contact { margin: 0.5rem 0 0; font-size: 0.95rem; color: #333; }
    .cv-toolbar {
      display: flex; gap: 0.75rem; margin: 1.5rem 0;
      font-family: system-ui, sans-serif;
    }
    .cv-toolbar a, .cv-toolbar button {
      display: inline-block; padding: 0.5rem 1rem; border-radius: 6px;
      border: 1px solid #333; background: #f5f5f5; color: #111;
      font-size: 0.95rem; text-decoration: none; cursor: pointer;
    }
    .cv-toolbar a:hover, .cv-toolbar button:hover { background: #e8e8e8; }
    section { margin-top: 1.75rem; }
    h2 {
      font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.06em;
      border-bottom: 2px solid #111; padding-bottom: 0.25rem; margin: 0 0 0.75rem;
    }
    h3 { margin: 0.75rem 0 0.1rem; font-size: 1rem; }
    .meta { margin: 0; font-size: 0.9rem; color: #444; }
    .item { margin-bottom: 0.9rem; }
    .item p { margin: 0.25rem 0 0; }
    ul.skill-list { columns: 2; column-gap: 2rem; margin: 0; padding-left: 1.25rem; }
    ul.skill-list li { margin-bottom: 0.3rem; }
    .empty { color: #555; font-style: italic; }
    @media print {
      .cv-toolbar { display: none; }
      body { max-width: none; padding: 0; }
      @page { margin: 1.5cm; }
    }
  </style>
</head>
<body>
  <header>
    <% if (profile) { %>
      <h1><%= profile.name %></h1>
      <% if (profile.role) { %><p class="role"><%= profile.role %></p><% } %>
      <% if (profile.summary) { %><p class="meta"><%= profile.summary %></p><% } %>
      <% if (profile.contact_info) { %><p class="contact"><%= profile.contact_info %></p><% } %>
    <% } else { %>
      <h1>Curriculum Vitae</h1>
      <p class="empty">No profile created yet.</p>
    <% } %>
  </header>

  <% if (!download) { %>
  <div class="cv-toolbar">
    <a href="/manage/cv/download">Download CV</a>
    <button type="button" onclick="window.print()">Print / Save as PDF</button>
    <a href="/manage">Back to dashboard</a>
  </div>
  <% } %>

  <section aria-labelledby="cv-summary">
    <h2 id="cv-summary">Professional Summary</h2>
    <% if (profile && profile.summary) { %>
      <p><%= profile.summary %></p>
    <% } else { %>
      <p class="empty">No summary available.</p>
    <% } %>
  </section>

  <section aria-labelledby="cv-skills">
    <h2 id="cv-skills">Skills</h2>
    <% if (skills.length === 0) { %>
      <p class="empty">No published skills yet.</p>
    <% } else { %>
      <ul class="skill-list">
        <% skills.forEach(function (s) { %>
          <li><strong><%= s.name %></strong><% if (s.description) { %> — <%= s.description %><% } %></li>
        <% }); %>
      </ul>
    <% } %>
  </section>

  <section aria-labelledby="cv-experience">
    <h2 id="cv-experience">Professional Experience</h2>
    <% if (experiences.length === 0) { %>
      <p class="empty">No experience entries yet.</p>
    <% } else { %>
      <% experiences.forEach(function (e) { %>
        <div class="item">
          <h3><%= e.title %> — <%= e.company %></h3>
          <p class="meta"><%= e.start_date %><%= e.end_date ? ' – ' + e.end_date : ' – present' %></p>
          <% if (e.description) { %><p><%= e.description %></p><% } %>
        </div>
      <% }); %>
    <% } %>
  </section>

  <section aria-labelledby="cv-education">
    <h2 id="cv-education">Education</h2>
    <% if (educations.length === 0) { %>
      <p class="empty">No education entries yet.</p>
    <% } else { %>
      <% educations.forEach(function (e) { %>
        <div class="item">
          <h3><%= e.degree %> — <%= e.institution %></h3>
          <p class="meta"><%= e.start_date %><%= e.end_date ? ' – ' + e.end_date : ' – present' %><% if (e.field_of_study) { %> · <%= e.field_of_study %><% } %></p>
          <% if (e.description) { %><p><%= e.description %></p><% } %>
        </div>
      <% }); %>
    <% } %>
  </section>
</body>
</html>
