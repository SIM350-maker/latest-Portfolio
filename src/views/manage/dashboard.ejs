<%- include('../partials/header', { title, isAuthenticated: true, csrfToken }) %>

<h1>Management dashboard</h1>

<section class="stat-grid" aria-label="Content overview">
  <div class="stat"><span class="stat-number"><%= counts.projects %></span><span class="stat-label">Projects (<%= counts.publishedProjects %> published)</span></div>
  <div class="stat"><span class="stat-number"><%= counts.skills %></span><span class="stat-label">Skills (<%= counts.publishedSkills %> published)</span></div>
  <div class="stat"><span class="stat-number"><%= counts.claims %></span><span class="stat-label">Claims</span></div>
  <div class="stat"><span class="stat-number"><%= counts.evidence %></span><span class="stat-label">Evidence items</span></div>
  <div class="stat"><span class="stat-number"><%= counts.experiences %></span><span class="stat-label">Experience entries</span></div>
  <div class="stat"><span class="stat-number"><%= counts.educations %></span><span class="stat-label">Education entries</span></div>
</section>

  <section aria-labelledby="activity-heading">
    <h2 id="activity-heading">Recent activity</h2>
    <% if (recentActivity && recentActivity.length > 0) { %>
      <ul class="manage-list">
        <% recentActivity.forEach(function (a) { %>
          <li class="manage-item"><div class="manage-item-main">
            <p class="meta"><strong><%= a.action %></strong> · <%= a.table_name %>: <%= auditSummary(a) %> · by <%= a.changed_by || 'system' %> · <%= a.changed_at %></p>
          </div></li>
        <% }); %>
      </ul>
      <p><a href="/manage/activity">View full activity log</a></p>
    <% } else { %>
      <p class="meta">No recorded activity yet.</p>
    <% } %>
  </section>

  <nav aria-label="Management sections">
    <ul class="manage-links">
      <li><a href="/manage/profile">Profile</a> — <%= profile ? 'publication state: ' + profile.publication_state : 'not created yet' %></li>
      <li><a href="/manage/projects">Projects</a></li>
      <li><a href="/manage/skills">Skills</a></li>
      <li><a href="/manage/experience">Experience</a></li>
      <li><a href="/manage/education">Education</a></li>
      <li><a href="/manage/cv">CV (generate & download)</a></li>
      <li><a href="/manage/security">Security & credentials</a></li>
      <li><a href="/manage/activity">Activity log</a></li>
      <li><a href="/manage/claims">Claims</a></li>
      <li><a href="/manage/evidence">Evidence</a></li>
    </ul>
  </nav>

<%- include('../partials/footer') %>


