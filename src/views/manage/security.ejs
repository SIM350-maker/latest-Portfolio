<%- include('../partials/header', { title, isAuthenticated: true, csrfToken: '' }) %>

<h1>Security</h1>

<section aria-labelledby="credential-heading">
  <h2 id="credential-heading">Management credential</h2>
  <p class="meta">Active source: <strong><%= provenance.source %></strong><% if (provenance.rotated_at) { %> · last rotated <%= provenance.rotated_at %><% } %></p>
  <p class="hint">Rotating the credential stores the new hash in the database and supersedes the bootstrap value. Other sessions remain active until their timeout; sign out and sign in again to refresh this session.</p>
  <% if (rotated) { %>
    <div class="banner" role="status">Password rotated successfully. Use the new password at the next sign-in.</div>
  <% } %>
  <% if (fieldErrors && Object.keys(fieldErrors).length > 0) { %>
    <div class="banner banner-error" role="alert">Please fix the errors below.</div>
  <% } %>
  <form method="post" action="/manage/security/password" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-field">
      <label for="current_password">Current password <span aria-hidden="true">*</span></label>
      <input type="password" id="current_password" name="current_password" required autocomplete="current-password" aria-describedby="current_password-error">
      <% if (fieldErrors.current_password) { %><p class="field-error" id="current_password-error"><%= fieldErrors.current_password %></p><% } %>
    </div>
    <div class="form-field">
      <label for="new_password">New password <span aria-hidden="true">*</span></label>
      <input type="password" id="new_password" name="new_password" required minlength="12" autocomplete="new-password" aria-describedby="new_password-hint new_password-error">
      <p class="hint" id="new_password-hint">Minimum 12 characters.</p>
      <% if (fieldErrors.new_password) { %><p class="field-error" id="new_password-error"><%= fieldErrors.new_password %></p><% } %>
    </div>
    <div class="form-field">
      <label for="confirm_password">Confirm new password <span aria-hidden="true">*</span></label>
      <input type="password" id="confirm_password" name="confirm_password" required minlength="12" autocomplete="new-password" aria-describedby="confirm_password-error">
      <% if (fieldErrors.confirm_password) { %><p class="field-error" id="confirm_password-error"><%= fieldErrors.confirm_password %></p><% } %>
    </div>
    <button type="submit" class="button-primary">Rotate password</button>
  </form>
</section>

<%- include('../partials/footer') %>
