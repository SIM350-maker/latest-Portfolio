<%- include('../../partials/header', { title, isAuthenticated: true, csrfToken }) %>

<div class="manage-toolbar">
  <h1>Projects</h1>
  <a class="button-primary" href="/manage/projects/new">New project</a>
</div>

<% if (projects.length === 0) { %>
  <p>No projects yet. <a href="/manage/projects/new">Create the first one.</a></p>
<% } else { %>
  
<section aria-labelledby="search-heading">
  <h2 id="search-heading">Search projects</h2>
  <form method="get" action="/manage/projects" class="search-form">
    <label class="visually-hidden" for="q">Search</label>
    <input type="search" id="q" name="q" value="<%= typeof pagination !== 'undefined' && pagination.q ? pagination.q : '' %>" placeholder="title, description, technologies, role">
    <button type="submit" class="button-secondary">Search</button>
    <% if (typeof pagination !== 'undefined' && pagination.q) { %><a href="/manage/projects" class="link-button">Clear</a><% } %>
  </form>
</section>
<ul class="manage-list">
    <% projects.forEach(function (p) { %>
      <li class="manage-item">
        <div class="manage-item-main">
          <h2><%= p.title %></h2>
          <p class="meta">State: <strong><%= p.publication_state %></strong><% if (p.technologies) { %> · <%= p.technologies %><% } %></p>
        </div>
        <div class="manage-item-actions">
          <a href="/manage/preview/project/<%= p.id %>">Preview</a>
          <a href="/manage/projects/<%= p.id %>/edit">Edit</a>
          <% if (p.publication_state !== 'Published') { %>
            <form method="post" action="/manage/projects/<%= p.id %>/publish" class="inline-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="link-button">Publish</button>
            </form>
          <% } else { %>
            <form method="post" action="/manage/projects/<%= p.id %>/unpublish" class="inline-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="link-button">Unpublish</button>
            </form>
          <% } %>
          <form method="post" action="/manage/projects/<%= p.id %>/delete" class="inline-form" data-confirm="Delete this project? Projects with claims cannot be deleted.">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="link-button link-danger">Delete</button>
          </form>
        </div>
        <details class="edit-disclosure">
          <summary>Link evidence / skills</summary>
          <form method="post" action="/manage/projects/<%= p.id %>/evidence" class="inline-form attach-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label class="visually-hidden" for="proj-evidence-<%= p.id %>">Evidence ID to attach</label>
            <input type="number" id="proj-evidence-<%= p.id %>" name="evidence_id" min="1" placeholder="Evidence ID" required>
            <button type="submit" class="link-button">Attach evidence</button>
          </form>
          <form method="post" action="/manage/projects/<%= p.id %>/skills" class="inline-form attach-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label class="visually-hidden" for="proj-skill-<%= p.id %>">Skill ID to attach</label>
            <input type="number" id="proj-skill-<%= p.id %>" name="skill_id" min="1" placeholder="Skill ID" required>
            <button type="submit" class="link-button">Attach skill</button>
          </form>
        </details>
      </li>
    <% }); %>
  </ul>
  <%- include('../../partials/pagination', { pagination, basePath: '/manage/projects' }) %>
<% } %>

<%- include('../../partials/footer') %>




