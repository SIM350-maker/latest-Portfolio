<%- include('../../partials/header', { title, isAuthenticated: true, csrfToken }) %>

<h1>References</h1>
<p class="meta">Third-party contact details — private by design and never rendered on the public site.</p>

<section aria-labelledby="new-reference-heading">
  <h2 id="new-reference-heading">Add a reference</h2>
  <% if (fieldErrors && Object.keys(fieldErrors).length > 0) { %>
    <div class="banner banner-error" role="alert">Please fix the errors below.</div>
  <% } %>
  <form method="post" action="/manage/references" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-field">
      <label for="name">Name <span aria-hidden="true">*</span></label>
      <input type="text" id="name" name="name" value="<%= values.name || '' %>" required maxlength="200" aria-describedby="name-error">
      <% if (fieldErrors.name) { %><p class="field-error" id="name-error"><%= fieldErrors.name %></p><% } %>
    </div>
    <div class="form-field">
      <label for="role">Role</label>
      <input type="text" id="role" name="role" value="<%= values.role || '' %>" maxlength="200">
    </div>
    <div class="form-field">
      <label for="organization">Organization</label>
      <input type="text" id="organization" name="organization" value="<%= values.organization || '' %>" maxlength="200">
    </div>
    <div class="form-field">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" value="<%= values.email || '' %>" maxlength="200" aria-describedby="email-error">
      <% if (fieldErrors.email) { %><p class="field-error" id="email-error"><%= fieldErrors.email %></p><% } %>
    </div>
    <div class="form-field">
      <label for="phone">Phone</label>
      <input type="text" id="phone" name="phone" value="<%= values.phone || '' %>" maxlength="50">
    </div>
    <button type="submit" class="button-primary">Add reference</button>
  </form>
</section>

<% if (references.length === 0) { %>
  <p>No references yet.</p>
<% } else { %>
  <ul class="manage-list">
    <% references.forEach(function (r) { %>
      <li class="manage-item">
        <div class="manage-item-main">
          <h3><%= r.name %></h3>
          <p class="meta"><% if (r.role) { %><%= r.role %><% } %><% if (r.organization) { %> · <%= r.organization %><% } %><% if (r.email) { %> · <%= r.email %><% } %><% if (r.phone) { %> · <%= r.phone %><% } %></p>
        </div>
        <div class="manage-item-actions">
          <form method="post" action="/manage/references/<%= r.id %>/delete" class="inline-form" data-confirm="Delete this reference?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="link-button link-danger">Delete</button>
          </form>
        </div>
        <details class="edit-disclosure">
          <summary>Edit</summary>
          <form method="post" action="/manage/references/<%= r.id %>" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="form-field">
              <label for="ref-name-<%= r.id %>">Name <span aria-hidden="true">*</span></label>
              <input type="text" id="ref-name-<%= r.id %>" name="name" value="<%= r.name %>" required maxlength="200">
            </div>
            <div class="form-field">
              <label for="ref-role-<%= r.id %>">Role</label>
              <input type="text" id="ref-role-<%= r.id %>" name="role" value="<%= r.role || '' %>" maxlength="200">
            </div>
            <div class="form-field">
              <label for="ref-org-<%= r.id %>">Organization</label>
              <input type="text" id="ref-org-<%= r.id %>" name="organization" value="<%= r.organization || '' %>" maxlength="200">
            </div>
            <div class="form-field">
              <label for="ref-email-<%= r.id %>">Email</label>
              <input type="email" id="ref-email-<%= r.id %>" name="email" value="<%= r.email || '' %>" maxlength="200">
            </div>
            <div class="form-field">
              <label for="ref-phone-<%= r.id %>">Phone</label>
              <input type="text" id="ref-phone-<%= r.id %>" name="phone" value="<%= r.phone || '' %>" maxlength="50">
            </div>
            <button type="submit" class="button-secondary">Save changes</button>
          </form>
        </details>
      </li>
    <% }); %>
  </ul>
<% } %>

<%- include('../../partials/footer') %>
