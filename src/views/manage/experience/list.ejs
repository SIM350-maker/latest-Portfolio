<%- include('../../partials/header', { title, isAuthenticated: true, csrfToken }) %>

<h1>Experience</h1>

<section aria-labelledby="new-experience-heading">
  <h2 id="new-experience-heading">Add an experience entry</h2>
  <% if (fieldErrors && Object.keys(fieldErrors).length > 0) { %>
    <div class="banner banner-error" role="alert">Please fix the errors below.</div>
  <% } %>
  <form method="post" action="/manage/experience" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-field">
      <label for="title">Title <span aria-hidden="true">*</span></label>
      <input type="text" id="title" name="title" value="<%= values.title || '' %>" required maxlength="200" aria-describedby="title-error">
      <% if (fieldErrors.title) { %><p class="field-error" id="title-error"><%= fieldErrors.title %></p><% } %>
    </div>
    <div class="form-field">
      <label for="company">Company <span aria-hidden="true">*</span></label>
      <input type="text" id="company" name="company" value="<%= values.company || '' %>" required maxlength="200" aria-describedby="company-error">
      <% if (fieldErrors.company) { %><p class="field-error" id="company-error"><%= fieldErrors.company %></p><% } %>
    </div>
    <div class="form-field">
      <label for="location">Location</label>
      <input type="text" id="location" name="location" value="<%= values.location || '' %>" maxlength="200">
      <% if (fieldErrors.location) { %><p class="field-error" id="location-error"><%= fieldErrors.location %></p><% } %>
    </div>
    <div class="form-field">
      <label for="start_date">Start date <span aria-hidden="true">*</span></label>
      <input type="text" id="start_date" name="start_date" value="<%= values.start_date || '' %>" required maxlength="50" placeholder="e.g. 2024-01" aria-describedby="start_date-error">
      <% if (fieldErrors.start_date) { %><p class="field-error" id="start_date-error"><%= fieldErrors.start_date %></p><% } %>
    </div>
    <div class="form-field">
      <label for="end_date">End date</label>
      <input type="text" id="end_date" name="end_date" value="<%= values.end_date || '' %>" maxlength="50" placeholder="leave empty for present" aria-describedby="end_date-error">
      <% if (fieldErrors.end_date) { %><p class="field-error" id="end_date-error"><%= fieldErrors.end_date %></p><% } %>
    </div>
    <div class="form-field">
      <input type="checkbox" id="is_current" name="is_current" <% if (values.is_current) { %>checked<% } %>>
      <label for="is_current">This is my current role</label>
    </div>
    <div class="form-field">
      <label for="description">Description</label>
      <textarea id="description" name="description" rows="3" maxlength="5000" aria-describedby="description-error"><%= values.description || '' %></textarea>
      <% if (fieldErrors.description) { %><p class="field-error" id="description-error"><%= fieldErrors.description %></p><% } %>
    </div>
    <button type="submit" class="button-primary">Add experience</button>
  </form>
</section>

<% if (experiences.length === 0) { %>
  <p>No experience entries yet.</p>
<% } else { %>
  
<section aria-labelledby="search-heading">
  <h2 id="search-heading">Search experience</h2>
  <form method="get" action="/manage/experience" class="search-form">
    <label class="visually-hidden" for="q">Search</label>
    <input type="search" id="q" name="q" value="<%= typeof pagination !== 'undefined' && pagination.q ? pagination.q : '' %>" placeholder="title, company, description">
    <button type="submit" class="button-secondary">Search</button>
    <% if (typeof pagination !== 'undefined' && pagination.q) { %><a href="/manage/experience" class="link-button">Clear</a><% } %>
  </form>
</section>
<ul class="manage-list">
    <% experiences.forEach(function (e) { %>
      <li class="manage-item">
        <div class="manage-item-main">
          <h3><%= e.title %> — <%= e.company %></h3>
          <p class="meta"><%= formatRange(e.start_date, e.end_date) %><% if (e.location) { %> · <%= e.location %><% } %><% if (e.is_current) { %> · current<% } %></p>
          <% if (e.description) { %><p><%= e.description %></p><% } %>
        </div>
        <div class="manage-item-actions">
          <form method="post" action="/manage/experience/<%= e.id %>/delete" class="inline-form" data-confirm="Delete this experience entry?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="link-button link-danger">Delete</button>
          </form>
        </div>
        <details class="edit-disclosure">
          <summary>Edit</summary>
          <form method="post" action="/manage/experience/<%= e.id %>" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="form-field">
              <label for="exp-title-<%= e.id %>">Title <span aria-hidden="true">*</span></label>
              <input type="text" id="exp-title-<%= e.id %>" name="title" value="<%= e.title %>" required maxlength="200">
            </div>
            <div class="form-field">
              <label for="exp-company-<%= e.id %>">Company <span aria-hidden="true">*</span></label>
              <input type="text" id="exp-company-<%= e.id %>" name="company" value="<%= e.company %>" required maxlength="200">
            </div>
            <div class="form-field">
              <label for="exp-location-<%= e.id %>">Location</label>
              <input type="text" id="exp-location-<%= e.id %>" name="location" value="<%= e.location || '' %>" maxlength="200">
            </div>
            <div class="form-field">
              <label for="exp-start-<%= e.id %>">Start date <span aria-hidden="true">*</span></label>
              <input type="text" id="exp-start-<%= e.id %>" name="start_date" value="<%= e.start_date %>" required maxlength="50">
            </div>
            <div class="form-field">
              <label for="exp-end-<%= e.id %>">End date</label>
              <input type="text" id="exp-end-<%= e.id %>" name="end_date" value="<%= e.end_date || '' %>" maxlength="50" placeholder="leave empty for present">
            </div>
            <div class="form-field">
              <input type="checkbox" id="exp-current-<%= e.id %>" name="is_current" <% if (e.is_current) { %>checked<% } %>>
              <label for="exp-current-<%= e.id %>">This is my current role</label>
            </div>
            <div class="form-field">
              <label for="exp-desc-<%= e.id %>">Description</label>
              <textarea id="exp-desc-<%= e.id %>" name="description" rows="3" maxlength="5000"><%= e.description || '' %></textarea>
            </div>
            <button type="submit" class="button-secondary">Save changes</button>
          </form>
        </details>
      </li>
    <% }); %>
  </ul>
  <%- include('../../partials/pagination', { pagination, basePath: '/manage/experience' }) %>
<% } %>

<%- include('../../partials/footer') %>




