<%- include('../../partials/header', { title, isAuthenticated: true, csrfToken }) %>

<h1>Evidence</h1>
<p class="meta">Evidence stores references to external artifacts (repositories, deployments, documents) — never the artifacts themselves.</p>

<section aria-labelledby="new-evidence-heading">
  <h2 id="new-evidence-heading">Add evidence</h2>
  <% if (fieldErrors && Object.keys(fieldErrors).length > 0) { %>
    <div class="banner banner-error" role="alert">Please fix the errors below.</div>
  <% } %>
  <form method="post" action="/manage/evidence" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-field">
      <label for="description">Description</label>
      <textarea id="description" name="description" rows="2" maxlength="2000" aria-describedby="description-error"><%= values.description || '' %></textarea>
      <% if (fieldErrors.description) { %><p class="field-error" id="description-error"><%= fieldErrors.description %></p><% } %>
    </div>
    <div class="form-row">
      <div class="form-field">
        <label for="file_path">Reference URL</label>
        <input type="url" id="file_path" name="file_path" value="<%= values.file_path || '' %>" maxlength="2000" placeholder="https://github.com/…" aria-describedby="file_path-error">
        <% if (fieldErrors.file_path) { %><p class="field-error" id="file_path-error"><%= fieldErrors.file_path %></p><% } %>
      </div>
      <div class="form-field">
        <label for="file_type">Type</label>
        <input type="text" id="file_type" name="file_type" value="<%= values.file_type || '' %>" maxlength="100" placeholder="repository, deployment, document…" aria-describedby="file_type-error">
        <% if (fieldErrors.file_type) { %><p class="field-error" id="file_type-error"><%= fieldErrors.file_type %></p><% } %>
      </div>
    </div>
    <button type="submit" class="button-primary">Add evidence</button>
  </form>
</section>

<% if (evidence.length === 0) { %>
  <p>No evidence items yet.</p>
<% } else { %>
  <ul class="manage-list">
    <% evidence.forEach(function (e) { %>
      <li class="manage-item">
        <div class="manage-item-main">
          <h3><%= e.description || e.file_path || ('Evidence #' + e.id) %></h3>
          <p class="meta">
            <% if (e.file_path) { %><span class="truncate"><%= e.file_path %></span> · <% } %>
            <% if (e.file_type) { %><%= e.file_type %> · <% } %>
            <% if (e.claims.length > 0) { %>supports <%= e.claims.length %> claim(s)<% } else { %>supports no claims<% } %>
          </p>
        </div>
        <div class="manage-item-actions">
          <form method="post" action="/manage/evidence/<%= e.id %>/accessibility" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label class="visually-hidden" for="acc-<%= e.id %>">Accessibility status for evidence <%= e.id %></label>
            <select id="acc-<%= e.id %>" name="accessibility_status">
              <% accessibilityStates.forEach(function (s) { %>
                <option value="<%= s %>" <%= e.accessibility_status === s ? 'selected' : '' %>><%= s %></option>
              <% }); %>
            </select>
            <button type="submit" class="link-button">Set</button>
          </form>
          <form method="post" action="/manage/evidence/<%= e.id %>/delete" class="inline-form" data-confirm="Delete this evidence item? Its links to claims, projects, and skills are removed.">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="link-button link-danger">Delete</button>
          </form>
        </div>
      </li>
    <% }); %>
  </ul>
<% } %>

<%- include('../../partials/footer') %>

