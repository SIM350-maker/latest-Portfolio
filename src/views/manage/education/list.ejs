<%- include('../../partials/header', { title, isAuthenticated: true, csrfToken }) %>

<h1>Education</h1>

<section aria-labelledby="new-education-heading">
  <h2 id="new-education-heading">Add an education entry</h2>
  <% if (fieldErrors && Object.keys(fieldErrors).length > 0) { %>
    <div class="banner banner-error" role="alert">Please fix the errors below.</div>
  <% } %>
  <form method="post" action="/manage/education" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-field">
      <label for="institution">Institution <span aria-hidden="true">*</span></label>
      <input type="text" id="institution" name="institution" value="<%= values.institution || '' %>" required maxlength="200" aria-describedby="institution-error">
      <% if (fieldErrors.institution) { %><p class="field-error" id="institution-error"><%= fieldErrors.institution %></p><% } %>
    </div>
    <div class="form-field">
      <label for="degree">Degree <span aria-hidden="true">*</span></label>
      <input type="text" id="degree" name="degree" value="<%= values.degree || '' %>" required maxlength="200" aria-describedby="degree-error">
      <% if (fieldErrors.degree) { %><p class="field-error" id="degree-error"><%= fieldErrors.degree %></p><% } %>
    </div>
    <div class="form-field">
      <label for="field_of_study">Field of study</label>
      <input type="text" id="field_of_study" name="field_of_study" value="<%= values.field_of_study || '' %>" maxlength="200" aria-describedby="field_of_study-error">
      <% if (fieldErrors.field_of_study) { %><p class="field-error" id="field_of_study-error"><%= fieldErrors.field_of_study %></p><% } %>
    </div>
    <div class="form-field">
      <label for="start_date">Start date <span aria-hidden="true">*</span></label>
      <input type="text" id="start_date" name="start_date" value="<%= values.start_date || '' %>" required maxlength="50" placeholder="e.g. 2020-09" aria-describedby="start_date-error">
      <% if (fieldErrors.start_date) { %><p class="field-error" id="start_date-error"><%= fieldErrors.start_date %></p><% } %>
    </div>
    <div class="form-field">
      <label for="end_date">End date</label>
      <input type="text" id="end_date" name="end_date" value="<%= values.end_date || '' %>" maxlength="50" placeholder="leave empty for present" aria-describedby="end_date-error">
      <% if (fieldErrors.end_date) { %><p class="field-error" id="end_date-error"><%= fieldErrors.end_date %></p><% } %>
    </div>
    <div class="form-field">
      <label for="grade">Grade</label>
      <input type="text" id="grade" name="grade" value="<%= values.grade || '' %>" maxlength="100" placeholder="e.g. Second Class Honours">
      <% if (fieldErrors.grade) { %><p class="field-error" id="grade-error"><%= fieldErrors.grade %></p><% } %>
    </div>
        <div class="form-field">
      <label for="description">Description</label>
      <textarea id="description" name="description" rows="3" maxlength="5000" aria-describedby="description-error"><%= values.description || '' %></textarea>
      <% if (fieldErrors.description) { %><p class="field-error" id="description-error"><%= fieldErrors.description %></p><% } %>
    </div>
    <button type="submit" class="button-primary">Add education</button>
  </form>
</section>

<% if (educations.length === 0) { %>
  <p>No education entries yet.</p>
<% } else { %>
  <ul class="manage-list">
    <% educations.forEach(function (e) { %>
      <li class="manage-item">
        <div class="manage-item-main">
          <h3><%= e.degree %> — <%= e.institution %></h3>
          <p class="meta"><%= e.start_date %><%= e.end_date ? ' – ' + e.end_date : ' – present' %><% if (e.field_of_study) { %> · <%= e.field_of_study %><% } %><% if (e.description) { %> · <%= e.description %><% } %></p>
          <% if (fieldErrors && fieldErrors['edit_' + e.id]) { %><p class="field-error"><%= fieldErrors['edit_' + e.id] %></p><% } %>
        </div>
        <div class="manage-item-actions">
          <form method="post" action="/manage/education/<%= e.id %>/delete" class="inline-form" data-confirm="Delete this education entry?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="link-button link-danger">Delete</button>
          </form>
        </div>
        <details class="edit-disclosure">
          <summary>Edit</summary>
          <form method="post" action="/manage/education/<%= e.id %>" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="form-field">
              <label for="edu-inst-<%= e.id %>">Institution <span aria-hidden="true">*</span></label>
              <input type="text" id="edu-inst-<%= e.id %>" name="institution" value="<%= e.institution %>" required maxlength="200">
            </div>
            <div class="form-field">
              <label for="edu-degree-<%= e.id %>">Degree <span aria-hidden="true">*</span></label>
              <input type="text" id="edu-degree-<%= e.id %>" name="degree" value="<%= e.degree %>" required maxlength="200">
            </div>
            <div class="form-field">
              <label for="edu-field-<%= e.id %>">Field of study</label>
              <input type="text" id="edu-field-<%= e.id %>" name="field_of_study" value="<%= e.field_of_study || '' %>" maxlength="200">
            </div>
            <div class="form-field">
              <label for="edu-start-<%= e.id %>">Start date <span aria-hidden="true">*</span></label>
              <input type="text" id="edu-start-<%= e.id %>" name="start_date" value="<%= e.start_date %>" required maxlength="50">
            </div>
            <div class="form-field">
              <label for="edu-end-<%= e.id %>">End date</label>
              <input type="text" id="edu-end-<%= e.id %>" name="end_date" value="<%= e.end_date || '' %>" maxlength="50">
            </div>
            <div class="form-field">
              <label for="edu-grade-<%= e.id %>">Grade</label>
              <input type="text" id="edu-grade-<%= e.id %>" name="grade" value="<%= e.grade || '' %>" maxlength="100">
            </div>
            <div class="form-field">
              <label for="edu-desc-<%= e.id %>">Description</label>
              <textarea id="edu-desc-<%= e.id %>" name="description" rows="3" maxlength="5000"><%= e.description || '' %></textarea>
            </div>
            <button type="submit" class="button-secondary">Save changes</button>
          </form>
        </details>
      </li>
    <% }); %>
  </ul>
<% } %>

<%- include('../../partials/footer') %>

