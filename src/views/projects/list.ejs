<%- include('../partials/header', { title, isAuthenticated, csrfToken: '' }) %>

<h1>Projects</h1>
<% if (projects.length === 0) { %>
  <p>No published projects yet.</p>
<% } else { %>
  <ul class="card-list">
    <% projects.forEach(function (p) { %>
      <li class="card">
        <h2><a href="/projects/<%= p.id %>"><%= p.title %></a></h2>
        <% if (p.description) { %><p><%= p.description.length > 220 ? p.description.slice(0, 220) + '…' : p.description %></p><% } %>
        <% if (p.technologies) { %><p class="meta">Technologies: <%= p.technologies %></p><% } %>
      </li>
    <% }); %>
  </ul>
<% } %>

<%- include('../partials/footer') %>
