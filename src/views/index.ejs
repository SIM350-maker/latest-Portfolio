<%- include('partials/header', { title, isAuthenticated, csrfToken: typeof csrfToken !== 'undefined' ? csrfToken : '' }) %>

<section class="hero">
  <% if (profile) { %>
    <h1><%= profile.name %></h1>
    <p class="role"><%= profile.role %></p>
    <p class="summary"><%= profile.summary %></p>
    <% if (profile.contact_info) { %>
      <p class="contact"><span class="visually-hidden">Contact information: </span><%= profile.contact_info %></p>
    <% } %>
  <% } else { %>
    <h1>Portfolio</h1>
    <p class="summary">This portfolio has not been published yet. Please check back soon.</p>
  <% } %>
</section>

<% if (profile && (projects.length > 0 || skills.length > 0)) { %>
  <section aria-labelledby="home-projects">
    <h2 id="home-projects">Projects</h2>
    <ul class="card-list">
      <% projects.forEach(function (p) { %>
        <li class="card">
          <h3><a href="/projects/<%= p.id %>"><%= p.title %></a></h3>
          <% if (p.description) { %><p><%= p.description.length > 160 ? p.description.slice(0, 160) + '…' : p.description %></p><% } %>
        </li>
      <% }); %>
    </ul>
  </section>

  <section aria-labelledby="home-skills">
    <h2 id="home-skills">Skills</h2>
    <ul class="chip-list">
      <% skills.forEach(function (s) { %>
        <li class="chip"><a href="/skills/<%= s.id %>"><%= s.name %></a></li>
      <% }); %>
    </ul>
  </section>
<% } %>

<%- include('partials/footer') %>
