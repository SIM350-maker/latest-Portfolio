<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' && title ? title + ' · Portfolio' : 'Portfolio' %></title>
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : 'Evidence-based engineering portfolio — projects, skills, and verifiable claims.' %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Portfolio">
  <meta property="og:title" content="<%= typeof title !== 'undefined' && title ? title : 'Portfolio' %>">
  <meta property="og:description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : 'Evidence-based engineering portfolio — projects, skills, and verifiable claims.' %>">
  <% if (typeof publicBaseUrl !== 'undefined' && publicBaseUrl) { %>
  <meta property="og:url" content="<%= publicBaseUrl %><%= typeof ogPath !== 'undefined' && ogPath ? ogPath : '' %>">
  <% } %>
  <link rel="stylesheet" href="/css/styles.css">
  <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
  <script src="/js/live.js" defer></script>
  <% } %>
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>
  <header class="site-header">
    <nav class="site-nav" aria-label="Main navigation">
      <a class="brand" href="/">Portfolio</a>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/projects">Projects</a></li>
        <li><a href="/skills">Skills</a></li>
        <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
          <li><a href="/manage">Manage</a></li>
          <li>
            <form method="post" action="/manage/logout" class="inline-form">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              <button type="submit" class="link-button">Sign out</button>
            </form>
          </li>
        <% } %>
      </ul>
    </nav>
  </header>
  <main id="main" class="site-main">
  <% if (typeof preview !== 'undefined' && preview) { %>
    <div class="banner banner-preview" role="status">Preview — this content may not be published yet.</div>
  <% } %>

