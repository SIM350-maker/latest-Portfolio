# Environment configuration template
# Copy to .env and fill in real values. NEVER commit .env (see .gitignore).

# Required: session signing secret (min 32 chars, random)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Server port (default 3000)
PORT=3000

# Node environment: development | test | production
NODE_ENV=development

# SQLite database file path (relative to project root). Defaults per NODE_ENV:
#   development -> data/dev.db, test -> data/test.db
DB_PATH=

# Owner credential for the private management system.
# BCRYPT_HASH: bcrypt hash (>=12 rounds) of the management password.
# NOTE: escape every "$" as "$$" so docker compose interpolation passes the hash through.
# The app loader unescapes "$$" -> "$" for local (dotenv) runs.
# Generate: node -e "const b=require('bcryptjs');console.log(b.hashSync('YOUR-PASSWORD',12).replace(/\$/g,'$$$$'))"
OWNER_BCRYPT_HASH=
